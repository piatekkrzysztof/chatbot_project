# Do kontekstu buildu trafia wyłącznie kod i jawnie wskazane pliki runtime.
# Wyjątki dla .env działają także wewnątrz pakietów aplikacji.
# Nie dopuszczamy całych katalogów: taki wyjątek dopuszcza również ich dane.
**
!requirements.txt
!requirements-dev.txt
!manage.py
!accounts/**/*.py
!accounts/templates/admin/mfa_login.html
!api/**/*.py
!chat/**/*.py
!chatbot_project/**/*.py
!documents/**/*.py
!rag/**/*.py
!rag/ocena/wzorzec.json

**/tests
**/tests/**
**/tests.py
**/test_*.py
**/conftest.py
**/__pycache__
**/__pycache__/**
**/.env*
**/*.pem
**/*.key
**/*.sqlite*
**/media/**
**/private-media/**
**/backups/**
**/.git/**
**/venv/**
**/.venv/**
