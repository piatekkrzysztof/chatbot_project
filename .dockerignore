# Do kontekstu buildu trafia wyłącznie kod i jawnie wskazane pliki runtime.
# Wyjątki dla .env działają także wewnątrz pakietów aplikacji.
**
!requirements.txt
!requirements-dev.txt
!manage.py
!accounts
!accounts/**/*.py
!api
!api/**/*.py
!chat
!chat/**/*.py
!chatbot_project
!chatbot_project/**/*.py
!documents
!documents/**/*.py
!rag
!rag/**/*.py
!rag/ocena/wzorzec.json

**/tests
**/tests/**
**/test_*.py
**/conftest.py
**/__pycache__
**/__pycache__/**
**/.env*
**/*.pem
**/*.key
**/*.sqlite*
**/media/**
**/backups/**
**/.git/**
**/venv/**
**/.venv/**
