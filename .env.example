# Skopiuj do .env i uzupełnij prawdziwymi wartościami. Nigdy nie commituj .env.

# Django
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Baza danych (PostgreSQL, format dj-database-url)
DATABASE_URL=postgres://user:password@localhost:5432/chatbot

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=

# Email (SMTP)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Frontend
FRONTEND_URL=http://localhost:3000

# AWS S3 (storage plików w produkcji)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEFAULT_PRICE_ID=

# Sentry (opcjonalnie)
SENTRY_DSN=
