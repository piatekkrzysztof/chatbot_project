# Skopiuj do .env i uzupełnij prawdziwymi wartościami. Nigdy nie commituj .env.

# Django
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Baza danych (PostgreSQL, format dj-database-url)
DATABASE_URL=postgres://user:password@localhost:5432/chatbot

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=
# Model czatu — zmiana nie wymaga zmian w kodzie
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Ile ostatnich wiadomości trafia do modelu jako kontekst rozmowy
CHAT_HISTORY_LIMIT=10
# Bot ma odtwarzać wiedzę firmy, nie tworzyć — wyższe wartości zachęcają go
# do uzupełniania luk własnymi domysłami
OPENAI_TEMPERATURE=0.2

# Email (SMTP)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Frontend
FRONTEND_URL=http://localhost:3000

# Magazyn wgrywanych plików: logotypy i awatary widgetu oraz dokumenty klientów.
#
# Puste = pliki lądują na dysku, który na Renderze znika przy każdym wdrożeniu.
# Lokalnie to w porządku, na produkcji oznacza znikające logotypy klientów —
# `manage.py check` wtedy o tym ostrzega.
#
# Wypełnij WSZYSTKIE TRZY albo ŻADNEJ. Zostawienie wartości zastępczych typu
# "..." włącza magazyn obiektowy z nieprawidłowymi danymi i wgrywanie plików
# zacznie się wywalać.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Amazon S3: nazwa regionu, np. eu-central-1. Cloudflare R2: zostaw "auto".
AWS_S3_REGION_NAME=auto
# Tylko dla magazynów innych niż Amazon (R2, Backblaze B2, MinIO) — ich endpoint,
# np. https://<identyfikator konta>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=
# Domena, spod której pliki są serwowane odwiedzającym strony klientów.
# Przy R2 to adres r2.dev kubełka albo własna subdomena.
AWS_S3_CUSTOM_DOMAIN=

# Stripe
STRIPE_SECRET_KEY=
# Sekret podpisu webhooka — bez niego każdy mógłby aktywować sobie dowolny plan
STRIPE_WEBHOOK_SECRET=
# Identyfikator ceny (price_...) osobno dla każdego planu z accounts/plans.py.
# Puste = plan widoczny, ale niemożliwy do kupienia (czytelny komunikat zamiast błędu).
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Sentry (opcjonalnie)
SENTRY_DSN=
